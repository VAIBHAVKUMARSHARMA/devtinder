PORT=3000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/devtinder
JWT_SECRET=replace-with-a-secure-secret
FRONTEND_URL=http://localhost:5173
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
GEMINI_API_KEY=your-gemini-api-key
WORKSPACE_RUN_TIMEOUT_MS=10000
WORKSPACE_RUN_MAX_OUTPUT_BYTES=131072
WORKSPACE_RUN_MAX_FILES=200
WORKSPACE_RUN_MAX_TOTAL_BYTES=1048576
WORKSPACE_TERMINAL_TIMEOUT_MS=120000
WORKSPACE_TERMINAL_MAX_OUTPUT_BYTES=524288
WORKSPACE_TERMINAL_MAX_FILE_BYTES=262144
WORKSPACE_TERMINAL_MAX_SYNC_BYTES=2097152
